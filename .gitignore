# ---- Unity generated ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin / VS / VSCode
.idea/
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vscode/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS files
.DS_Store
Thumbs.db

# Local player builds (테스트 빌드·자동 플레이 결과)
/Builds/

# 글꼴: ZEN SERIF — 라이선스상 파일 재배포 금지 (공개 저장소에 올리지 않음). 팀원은 같은 위치에 직접 넣는다.
/Assets/_Project/Resources/Fonts/ZEN-SERIF-TTF-Regular.ttf
/Assets/_Project/Resources/Fonts/ZEN-SERIF-TTF-Regular.ttf.meta


# 디자인에서 받은 원본 묶음 (unitypackage·Meshy FBX 원본, 약 1GB) — 로컬 보관만, git 제외 (2026-11-06)
# 게임에 쓰는 것은 Assets/_Project/Art/Models/에 줄여서 들어가 있음. 팀원은 팀 공유 폴더에서 받기
/ArtSource/

# 받은 아이템 3D 모델 (2026-11-12): 아이콘 촬영용(ItemIconStudio)만 씀. 게임엔 아이콘 그림만 들어감. 원본은 ArtSource 2026-11-11_디자인_ 폴더들
/Assets/_Project/Art/Models/Items/
/Assets/_Project/Art/Models/Items.meta
